{
  "schemaVersion": 1,
  "id": "regnum-agriculture",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contributors": [
    "${mod_credits}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "assets/regnum-agriculture/icon.png",
  "environment": "*",
  "provides": [
    "farmersdelight"
  ],
  "entrypoints": {
    "main": [
      "com.projectregnum.agriculture.RegnumAgriculture"
    ],
    "client": [
      "com.projectregnum.agriculture.client.RegnumAgricultureClient"
    ],
    "fabric-datagen": [
      "vectorwing.farmersdelight.data.DataGenerators"
    ],
    "jei_mod_plugin": [
      "vectorwing.farmersdelight.integration.jei.JEIPlugin"
    ],
    "rei_client": [
      "vectorwing.farmersdelight.integration.rei.ClientREIPlugin"
    ],
    "rei_server": [
      "vectorwing.farmersdelight.integration.rei.ServerREIPlugin"
    ],
    "emi": [
      "vectorwing.farmersdelight.integration.emi.EMIPlugin"
    ],
    "modmenu": [
      "vectorwing.farmersdelight.integration.modmenu.ModMenuCompat"
    ]
  },
  "mixins": [
    "farmersdelight.mixins.json"
  ],
  "accessWidener": "farmersdelight.classtweaker",
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_min_version} <=${minecraft_max_version}"
  }
}